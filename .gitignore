# Downloaded 3GPP specifications — large, and fetchable via scripts/download_3gpp.py.
# The bundled condensed .txt corpus IS tracked (see the negations below).
backend/data/corpus/*
!backend/data/corpus/23501-5gs-architecture.txt
!backend/data/corpus/23502-5gs-procedures.txt
!backend/data/corpus/24501-nas-5gs.txt
!backend/data/corpus/33501-5g-security.txt
!backend/data/corpus/38300-nr-overall.txt

# Evaluation output
backend/report.json
backend/eval/*.json
!backend/eval/golden_set.json

