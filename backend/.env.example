# ---------------------------------------------------------------------------
# Copy to `.env` and fill in.  Only ANTHROPIC_API_KEY is really required.
# ---------------------------------------------------------------------------

# ---- LLM provider ----------------------------------------------------------
# NEITHER key is required. With no key the system runs in EXTRACTIVE mode:
# retrieval, clause-level citations, the numeric guard and abstention gate 1
# all work; it returns verbatim spec text instead of a synthesised answer.
#
# A key enables the two anti-hallucination checks that need reading
# comprehension: gate 2 ("the sources don't contain this") and the per-claim
# entailment verification.
#
# Set ONE of these. Gemini wins if both are present; override with LLM_PROVIDER.

# Google AI Studio -> https://aistudio.google.com/apikey   (has a free tier)
GEMINI_API_KEY=

# Anthropic Console -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# auto | gemini | anthropic
LLM_PROVIDER=auto

# ---- Models ----------------------------------------------------------------
# Leave blank to use the provider defaults below. The verifier runs on every
# turn and only makes bounded yes/no judgements, so a fast model there is both
# sufficient and the main cost lever.
#
#   gemini     answer=gemini-2.5-pro    verifier=gemini-2.5-flash  rewrite=gemini-2.5-flash
#   anthropic  answer=claude-opus-5     verifier=claude-opus-5     rewrite=claude-opus-5
#
# For a cheaper Gemini setup, set ANSWER_MODEL=gemini-2.5-flash.
ANSWER_MODEL=
VERIFIER_MODEL=
REWRITE_MODEL=

# ---- Retrieval tuning ------------------------------------------------------
RETRIEVAL_TOP_K=24          # candidates pulled from each retriever
RERANK_TOP_N=6              # chunks actually shown to the LLM
DENSE_WEIGHT=1.0            # RRF weight for the dense retriever
SPARSE_WEIGHT=1.0           # RRF weight for the BM25 retriever
RRF_K=60                    # reciprocal-rank-fusion smoothing constant

# ---- Anti-hallucination thresholds ----------------------------------------
# Below this rerank score for the best chunk, the system abstains BEFORE
# spending a single generation token.
# Calibrate with: python scripts/calibrate_threshold.py
# (0.42 is the calibrated value for the bundled corpus + lexical reranker;
#  a cross-encoder produces a different distribution and needs recalibrating.)
MIN_RETRIEVAL_SCORE=0.42
# Fraction of claims that must survive verification for a non-hedged answer.
MIN_SUPPORT_RATIO=0.6
# Turn the second-pass entailment verifier on/off (costs one extra LLM call).
ENABLE_VERIFIER=true
# Deterministic check that numbers/identifiers appear in the cited text.
ENABLE_NUMERIC_GUARD=true
# Gate 1.5: refuse questions asserting an identifier that appears nowhere in the
# retrieved clauses ("timer T3599", "5QI 91"). Free, and the only false-premise
# defence available when no LLM key is configured.
ENABLE_PREMISE_GUARD=true

# ---- Paths -----------------------------------------------------------------
CORPUS_DIR=data/corpus
INDEX_DIR=data/index
DB_PATH=data/chat.db

# ---- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=5001
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
