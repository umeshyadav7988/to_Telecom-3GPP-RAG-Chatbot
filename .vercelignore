# Keep the serverless bundle small and the build fast.
# NOTE: backend/data/corpus/ must NOT be ignored — the index is rebuilt from it
# on every cold start (AUTO_INDEX_ON_BOOT).

# backend/eval/ is intentionally NOT ignored: /api/evaluation imports
# eval.metrics and reads eval/golden_set.json at request time.

backend/.venv/
backend/tests/
backend/scripts/
backend/data/index/
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/requirements-ml.txt

**/__pycache__/
**/*.pyc
**/.pytest_cache/

node_modules/

# frontend/dist/ must NOT be listed here: it is the outputDirectory declared in
# vercel.json. Ignoring it leaves the deployment with no static assets, so every
# path falls through the SPA rewrite into the Python function, and Flask answers
# /index.html with its JSON 404 handler.

docs/
start.sh
.git/
.gitignore
README.md
