{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",

  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{backend,frontend/dist}/**"
    }
  },

  "env": {
    "INDEX_DIR": "/tmp/rag-index",
    "DB_PATH": "/tmp/rag-chat.db",
    "AUTO_INDEX_ON_BOOT": "true",
    "CORS_ORIGINS": "*"
  },

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
